{
  "name": "jigyabyte-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.13.0" },
  "scripts": {
    "start": "node --env-file=.env src/server.ts",
    "dev": "node --watch --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "diagnose:wikipedia": "node src/diagnose-wikipedia.ts",
    "diagnose:gemini": "node --env-file=.env src/diagnose-gemini.ts",
    "prewarm": "node --env-file=.env src/prewarm.ts"
  },
  "devDependencies": { "@types/node": "26.6.5", "typescript": "~5.9.2" }
}
