# Server only. Enter your Gemini key on the next line.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional first fallback; used after retryable Gemini model-call failures.
GEMINI_FALLBACK_MODEL=
# Gemini 3 models: low reduces latency and leaves more output budget for card text.
# Leave blank for models that do not support thinkingLevel.
GEMINI_THINKING_LEVEL=
# Adding a key alone never activates generation.
GENERATION_PROVIDER=disabled
CONTENT_MODE=ai-only
# Confirm the chosen Gemini model/account is on a free, non-billed tier before enabling.
GEMINI_FREE_TIER_CONFIRMED=false
ALLOW_PAID_CALLS=false
DAILY_REQUEST_LIMIT=10
DAILY_TOKEN_LIMIT=50000
DAILY_COST_LIMIT=0
# Required upper-bound USD per request for paid mode (including input/output/reasoning).
MAX_REQUEST_COST=0
MAX_INPUT_TOKENS=8000
MAX_OUTPUT_TOKENS=4096

BACKEND_HOST=127.0.0.1
BACKEND_PORT=4319
# Generated locally in .env. Use this pairing token, never a provider key, on the phone.
BACKEND_DEVICE_TOKEN=
BACKEND_DATABASE=./data/backend.sqlite
UNREAD_MIN=50
UNREAD_REFILL_AT=55
UNREAD_TARGET=60
READ_NONFAVORITE_LIMIT=30
# Upper bound; the backend also fits the batch to the configured output-token ceiling.
GENERATION_BATCH_SIZE=30
# Public no-key sources; no paid news/search/grounding API.
LIVE_SOURCES_ENABLED=true
MAX_CONCURRENT_JOBS=1
MAX_CACHE_CARDS=500
REQUEST_TIMEOUT_MS=30000
