# Enter real secrets in Dashboard > Edge Functions > Secrets, or a private ignored .env file.
# Use Connect > Transaction pooler URI for this project; URL-encode the database password.
JIGYABYTE_DATABASE_URL=REPLACE_WITH_TRANSACTION_POOLER_URI
BACKEND_DEVICE_TOKEN=REPLACE_WITH_NEW_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
JIGYABYTE_WORKER_TOKEN=REPLACE_WITH_SEPARATE_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
GEMINI_API_KEY=REPLACE_WITH_EXISTING_KEY
GENERATION_PROVIDER=gemini
CONTENT_MODE=ai-only
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_FREE_TIER_CONFIRMED=true
ALLOW_PAID_CALLS=false
DAILY_REQUEST_LIMIT=30
DAILY_TOKEN_LIMIT=725760
DAILY_COST_LIMIT=0
MAX_REQUEST_COST=0
MAX_INPUT_TOKENS=16000
MAX_OUTPUT_TOKENS=8192
REQUEST_TIMEOUT_MS=60000
GENERATION_BATCH_SIZE=30
LIVE_SOURCES_ENABLED=true
MAX_CACHE_CARDS=5000
UNREAD_MIN=50
UNREAD_REFILL_AT=55
UNREAD_TARGET=60
READ_NONFAVORITE_LIMIT=30
